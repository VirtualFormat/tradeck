# OpenBB Platform API Keys
# 免费源不需要 key（yfinance/sec/fred/federal_reserve/bls/cftc 等开箱即用）
# 付费源配 key 后启用，留空则不加载该 Provider 的数据
#
# 本文件同时用于韩国节点瘦 OpenBB（docker-compose.overseas.yml）：
#   cp .env.example .env 后填入海外源 key（免费源可留空）

# FMP — 全球股票行情+基本面（$60/月，注册 financialmodelingprep.com）
FMP_API_KEY=

# FRED — 美联储宏观数据（免费，注册 fred.stlouisfed.org）
FRED_API_KEY=

# Finnhub — 新闻+情绪（免费档够用，注册 finnhub.io）
FINNHUB_API_KEY=

# Polygon — 美股实时行情（可选，$29/月）
POLYGON_API_KEY=

# Tiingo — 历史行情+新闻（可选，免费档）
TIINGO_API_KEY=

# Alpha Vantage — 全球股票+技术指标（可选，免费 25 req/day）
ALPHAVANTAGE_API_KEY=
