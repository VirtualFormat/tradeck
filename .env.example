# Tradeck 部署环境变量模板。真实令牌只写入本地 .env，禁止提交。

# ── 海外节点（韩国瘦 OpenBB）────────────────────────────
# 国内 backend 把海外 provider（yfinance/sec/fred/federal_reserve/oecd）
# 路由到韩国节点。留空则回落国内 openbb，行为不变。
# URL 为 CF 橙云域名；TOKEN 与韩国 nginx 校验的 X-OpenBB-Token 一致。
OPENBB_OVERSEAS_API_URL=
OPENBB_OVERSEAS_TOKEN=

# 数据中心手动同步令牌（prod 必填；留空时禁用手动触发）
# 使用高熵随机值，并确保 backend / web 读取同一值。
DATA_SYNC_TOKEN=

# ── 同花顺金融数据服务（可选 A 股官方源）─────────────────
# A 股行情快照/日K/估值/财务/涨停池等。Key 申请：https://fuyao.aicubes.cn/admin
# 留空则该源不可用（优雅降级，不影响其他源）。
HITHINK_FINANCE_API_KEY=

# ── findb 金融数据 API（同花顺失败时的 fallback + 一次性全量初始化源）──
# 只读、仅 GET、Bearer 鉴权；密钥一人一设备一把（共享会被吊销）。
# 留空则 findb 源不可用（优雅降级，相关 job 空跑返回 0 行）。
FINDB_KEY=
# findb API base（默认 https://api.jiucaicat.icu，一般无需改）
FINDB_BASE_URL=
# COS full 分发包（prod 默认值如下；通过 CVM 角色取临时凭证，不填永久密钥）
FINDB_ARCHIVE_BUCKET=thudata-1472715722
FINDB_ARCHIVE_REGION=ap-shanghai
FINDB_ARCHIVE_PREFIX=dist/full
FINDB_COS_ROLE=tradeck-app
# 自有 data pool 根目录由 compose 固定为 /data/market-pool，一般无需覆盖。

# ── 银河星耀数智 AmazingData（A 股官方源兜底，x86-64 only）──
# 账号/密码/服务器 IP/端口联系开户营业部申请；四项齐全才启用。
# 单点登录：同一时间只允许一个登录连接（collector 单实例天然契合）。
# 仿真账号当前只开放 L1 快照，默认禁用；明确置 1 才启用隔离 worker。
AMAZINGDATA_ENABLED=0
AD_USERNAME=
AD_PASSWORD=
AD_HOST=
AD_PORT=

# ── 量化引擎（可选）────────────────────────────────────
# 与 data-api 的 SERVICE_TOKENS 匹配的消费方令牌；dev 留空内网放行。
QUANT_SERVICE_TOKEN=
# AI 策略生成：全部留空即关闭。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── web 消费方鉴权（tradb data-api / collector）────────────
# tradb 独立部署时，web/quant 经宿主机回环访问 tradb 的地址：
# TRADB_API_URL=http://host.docker.internal:8080
# TRADB_COLLECTOR_URL=http://host.docker.internal:8082
# （留空则回退同 compose 服务名，即 tradeck 内嵌数据服务。）
TRADB_API_URL=
TRADB_COLLECTOR_URL=
# web（BFF）作为消费方调 tradb 时的 X-Service-Token，
# 与 tradb 侧 SERVICE_TOKENS 中的某个 token 对应；dev 留空内网放行（不带这两个头）。
# 仅在服务端注入，绝不进入浏览器包。
TRADB_SERVICE_TOKEN=
# web 消费方自报名（X-Service-Name），默认 web-bff，一般无需改。
TRADB_SERVICE_NAME=web-bff
