# --- PostgreSQL ---
POSTGRES_USER=tradeck
POSTGRES_PASSWORD=tradeck
POSTGRES_DB=tradeck
POSTGRES_PORT=5432
# connection string used by the api (host = compose service name)
DATABASE_URL=postgres://tradeck:tradeck@postgres:5432/tradeck

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- API ---
API_PORT=3000

# --- Web ---
# production nginx port in docker-compose.yml
PROD_WEB_PORT=8080
# Vite dev server port in .devcontainer/docker-compose.yml
DEV_WEB_PORT=5173
# base URL the browser uses to reach the api
VITE_API_BASE_URL=http://localhost:3000

# --- Futu OpenD ---
# OpenD runs as the futu-opend compose sidecar. The API reaches it by service name.
FUTU_OPEND_HOST=futu-opend
FUTU_OPEND_PORT=33333
FUTU_OPEND_SSL=true
FUTU_OPEND_KEY=tradeck-local-opend
FUTU_OPEND_TELNET_PORT=22222
FUTU_DEFAULT_ENABLED=false
FUTU_LOGIN_ACCOUNT=
FUTU_LOGIN_PWD_MD5=
# Prefer FUTU_LOGIN_PWD_MD5. Plain password is supported for local-only testing.
FUTU_LOGIN_PWD=
FUTU_OPEND_LANG=chs
FUTU_OPEND_LOG_LEVEL=info
# Dev compose uses an internal self-signed OpenD websocket cert.
NODE_TLS_REJECT_UNAUTHORIZED=0
