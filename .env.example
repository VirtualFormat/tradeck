# Tradeck 部署环境变量模板。真实令牌只写入本地 .env，禁止提交。
# 行情数据源密钥（OPENBB/TickFlow/findb/akshare 等）属 tradb 仓库，不在此处。

# ── 量化引擎（可选）────────────────────────────────────
# 与 tradb data-api 的 SERVICE_TOKENS 匹配的消费方令牌；dev 留空内网放行。
QUANT_SERVICE_TOKEN=
# 每日信号 cron（K1）：false 关闭；QUANT_SIGNAL_UNIVERSE 逗号分隔标的，空=默认 tracked 子集。
QUANT_SIGNAL_ENABLED=true
QUANT_SIGNAL_UNIVERSE=
# AI 策略生成：全部留空即关闭。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 采样温度：留空=不传（用服务端默认）。Kimi K3 等模型固定 temperature=1，传其他值会 400，
# 仅确认端点支持自定义时填写（如 0.3）。
AI_TEMPERATURE=
# quant 入站服务令牌（JSON {"<token>": "<consumer>"}，docs/MCP.md）：非空时 quant 只接受
# 持有效 X-Service-Token 的调用方，且 X-User-Id 必填。web 复用 TRADB_SERVICE_TOKEN，
# mcp 用 MCP_SERVICE_TOKEN，故 prod 配成 {"<TRADB_SERVICE_TOKEN 同值>": "web-bff", "<MCP_SERVICE_TOKEN 同值>": "mcp"}。
# 留空 = 不鉴权（dev / 首次升级兼容；上线 MCP 前必须配置）。
QUANT_INBOUND_SERVICE_TOKENS=
# 一次性迁移：把 quant 缓存里 users/default/ 下的策略/因子/候选库迁给该用户（u<auth.users.id>，
# 即日常使用的账号；prod 为 auth.users.id=2 → u2）。web 开始透传 X-User-Id 前必须配置，否则既有策略对用户不可见。
QUANT_MIGRATE_DEFAULT_TO=
# 每用户活跃任务上限（回测 + AI 生成合计），默认 2；<=0 不限。
QUANT_MAX_CONCURRENT_PER_USER=2
# 用户策略沙箱子进程降权 uid（默认 65534 nobody）；0 = 不降权（仅限排障）。
QUANT_SANDBOX_UID=65534

# ── web 消费方鉴权（tradb data-api / collector）────────────
# tradb 独立部署时，web/quant 经宿主机回环访问 tradb 的地址：
# TRADB_API_URL=http://host.docker.internal:8080
# TRADB_COLLECTOR_URL=http://host.docker.internal:8082
# （留空则回退 tradb_net 外部网络的容器别名 tradb-data-api / tradb-collector。）
TRADB_API_URL=
TRADB_COLLECTOR_URL=
# web（BFF）作为消费方调 tradb 时的 X-Service-Token，
# 与 tradb 侧 SERVICE_TOKENS 中的某个 token 对应；dev 留空内网放行（不带这两个头）。
# 仅在服务端注入，绝不进入浏览器包。
TRADB_SERVICE_TOKEN=
# web 消费方自报名（X-Service-Name），默认 web-bff，一般无需改。
TRADB_SERVICE_NAME=web-bff

# ── 用户登录（auth）────────────────────────────────────
# tradeck 自建 api 服务（auth-db + api，见 docker-compose.yml），
# 与 tradb 行情库物理分离；web 的 session 校验走 api（AUTH_API_URL 由 compose 固定）。
# auth-db 数据库密码：prod 必改强密码；留空用 dev 默认值 tradeck_dev（仅本地）。
AUTH_DB_PASSWORD=
# 邀请码：非空 = 邀请制注册（prod 内测期必填）；留空 = 开放注册。
AUTH_INVITE_CODE=
# session 有效期（天），默认 7。
AUTH_SESSION_DAYS=7
# api 消费方令牌（JSON）：web 会用 TRADB_SERVICE_TOKEN 作为 X-Service-Token
# 调 api 服务，这里必须配成 {"<与 TRADB_SERVICE_TOKEN 同值>": "web-bff"}。
# 启用 MCP 后追加 mcp：{"<TRADB_SERVICE_TOKEN 同值>": "web-bff", "<MCP_SERVICE_TOKEN 同值>": "mcp"}
# （PAT 校验接口 /api/auth/tokens/verify 只接受 consumer=mcp）。
# 留空 = api 不启用服务令牌校验（仅容器网络可达，内网可接受，建议 prod 配置）。
AUTH_SERVICE_TOKENS=
# 可签发个人访问令牌（PAT）的用户 id 名单（auth.users.id，逗号分隔，如 1,2,3）；
# 留空 = 所有登录用户均可签发。MCP 小范围使用期建议配置。
PAT_ALLOWED_USER_IDS=

# ── MCP 服务（docs/MCP.md）────────────────────────────────
# mcp 调 api（PAT 校验）与 quant 的服务令牌（同一把），须同时登记到
# AUTH_SERVICE_TOKENS 与 QUANT_INBOUND_SERVICE_TOKENS（consumer 名 mcp）。
MCP_SERVICE_TOKEN=
# 对外地址（resource url = MCP_PUBLIC_URL + /mcp；Host 白名单由其推出）
MCP_PUBLIC_URL=https://tradeck.virtualformat.cn
